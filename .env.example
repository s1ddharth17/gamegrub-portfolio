# Docker Compose development settings.
# Copy this file to .env if you want to override the defaults in compose.yaml.

MARIADB_DATABASE=gamegrub2
MARIADB_USER=gamegrub
MARIADB_PASSWORD=gamegrub_dev_password
MARIADB_ROOT_PASSWORD=gamegrub_root_password
MARIADB_HOST_PORT=3307

BACKEND_PORT=3001
ADMIN_PORT=3000
USER_WEB_PORT=3002
PHPMYADMIN_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

LOG_LEVEL=info
ENABLE_IN_PROCESS_CRON=true

# Optional operations alert webhook. Production webhook URLs must use HTTPS;
# configure a random secret of at least 24 characters when a URL is set.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_SECRET=
OPS_METRICS_WINDOW_MINUTES=5
OPS_API_ERROR_THRESHOLD=5
OPS_PAYMENT_FAILURE_THRESHOLD=3
OPS_ALERT_COOLDOWN_MINUTES=15

JWT_SECRET=local-development-jwt-secret-change-before-production
OTP_PEPPER=local-development-otp-pepper-change-before-production
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@gamegrub.local

# Optional Razorpay test-mode credentials for online checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
PAYMENT_CHECKOUT_PUBLIC_URL=

# Optional Firebase Cloud Messaging setup for push notifications.
# Use a single-line JSON service-account value with escaped newlines for private_key.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_VAPID_KEY=
USER_APP_PUBLIC_URL=http://localhost:3002

# Public Firebase app configuration used by the Flutter user app build.
FIREBASE_API_KEY=
FIREBASE_APP_ID_WEB=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# Optional integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
