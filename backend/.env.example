PORT=3001
HOST=0.0.0.0
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info
LOG_SERVICE_NAME=gamegrub-backend
# Prefer false in production unless this service is the dedicated cron worker.
ENABLE_IN_PROCESS_CRON=false
SESSION_ENGINE_INTERVAL_MS=60000
NO_SHOW_ENGINE_INTERVAL_MS=60000
STATION_WAITLIST_ENGINE_INTERVAL_MS=10000
CRON_HEALTH_STALE_MULTIPLIER=2
CRON_LOCK_TIMEOUT_SECONDS=0
NO_SHOW_GRACE_MINUTES=15
# Comma-separated browser origins, for example:
# http://localhost:3000,https://admin.your-domain.com,https://app.your-domain.com
CORS_ALLOWED_ORIGINS=https://admin.your-domain.com,https://app.your-domain.com

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gamegrub2
DB_MIGRATIONS_TABLE=schema_migrations
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Razorpay Standard Checkout. Keys stay on the backend; use test-mode keys for sandbox checks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
PAYMENT_CURRENCY=INR
# Public backend URL used by the hosted checkout page; leave blank for same-host local development.
PAYMENT_CHECKOUT_PUBLIC_URL=

# Production startup validation will fail if these stay blank or placeholder values.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=12h
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=30
BCRYPT_SALT_ROUNDS=10
OTP_PEPPER=replace-with-a-long-random-secret

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5-mini

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

UPLOAD_STORAGE=local
UPLOADS_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=

AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_KEY_PREFIX=gamegrub
