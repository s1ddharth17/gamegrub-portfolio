    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.19.1",
    "nodemailer": "^9.0.3",
    "openai": "^6.34.0"
  },
  "overrides": {
    "fast-xml-builder": "^1.2.1",
